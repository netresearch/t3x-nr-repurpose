# EditorConfig: https://editorconfig.org
# Documentation/ has its own .editorconfig (root = true) for the RST rules.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# XLIFF: 2-space indentation, the TYPO3 v14 convention
[*.xlf]
indent_size = 2

# DDEV custom commands (install) are 2-space shell scripts, like DDEV's own
[.ddev/commands/**]
indent_size = 2
