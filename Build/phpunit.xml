<!--
    ../phpunit-baseline.xml is shared with FunctionalTests.xml; see the comment
    there. For the unit suite it holds the spl_object_hash() deprecation PHP 8.6
    raises in smalot/pdfparser (PDFObject.php). Delete that entry once
    pdfparser stops calling spl_object_hash().
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../.Build/vendor/typo3/testing-framework/Resources/Core/Build/UnitTestsBootstrap.php"
         cacheDirectory="../.Build/.phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory>../Tests/Unit/</directory>
        </testsuite>
    </testsuites>
    <source baseline="../phpunit-baseline.xml">
        <include>
            <directory>../Classes</directory>
        </include>
    </source>
</phpunit>
