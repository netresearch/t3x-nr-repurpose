<!--
    failOnDeprecation is on. TYPO3 core raises two deprecations while it boots
    the test instance, both caused by dependencies, not by a call in Classes/:
    #108345 for nr_vault (its composer.json lacks extra.typo3/cms.version and
    Package.providesPackages) and the ctrl.searchFields TCA migration for the
    tx_nrllm_* and tx_nrvault_* tables. ../phpunit-baseline.xml lists exactly
    those two messages; it sits in the repository root because PHPUnit 11.5
    does not normalise the Build/../.Build/ paths a baseline under Build/ would
    record, so such a baseline never matches. Delete the entries once nr-vault
    and nr-llm release their fixes. A new deprecation, or a changed message
    from either dependency, fails the suite. So does a TYPO3 14.3.x release
    that moves either trigger line: PHPUnit 11.5 matches a baseline entry on
    file, line and message together. To regenerate, run
    ./Build/Scripts/runTests.sh -s functional with PHPUnit's generate-baseline
    option set to phpunit-baseline.xml (a double dash cannot appear in an XML
    comment); it writes the file in the repository root.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../.Build/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
         cacheDirectory="../.Build/.phpunit.cache"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         failOnDeprecation="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="functional">
            <directory>../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <source baseline="../phpunit-baseline.xml">
        <include>
            <directory>../Classes</directory>
        </include>
    </source>
    <php>
        <ini name="display_errors" value="1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
        <!-- Default to SQLite so CI and `runTests.sh -s functional` need no DB service;
             `runTests.sh -d mariadb|mysql|postgres` overrides this via container env. -->
        <env name="typo3DatabaseDriver" value="pdo_sqlite"/>
    </php>
</phpunit>
