# Entry point for `composer ci:test:php:phpstan` and `runTests.sh -s phpstan`
# / `-s architecture` (the runner finds Build/phpstan.neon before phpstan.neon).
#
# The analysis settings stay in ../phpstan.neon; this file adds the phpat
# architecture rules from Tests/Architecture. They run inside the normal
# PHPStan pass, so a violation fails the PHPStan job.
includes:
    - ../phpstan.neon

parameters:
    phpat:
        ignore_built_in_classes: true

services:
    -
        class: Netresearch\NrRepurpose\Tests\Architecture\AiBoundaryTest
        tags:
            - phpat.test
    -
        class: Netresearch\NrRepurpose\Tests\Architecture\LayerTest
        tags:
            - phpat.test
